@app.route('/get_user/<email>')
def get_user(email):
    user = db.users.find_one({"email": email}, {"_id": 0, "password": 0})
    return jsonify(user)

@app.route('/update_user', methods=['POST'])
def update_user():
    data = request.json
    email = data['email'].lower()
    user = db.users.find_one({"email": email}, {"_id": 0, "password": 0})
    name = data.get('name', user.get('name', 'User'))
    role = data.get('role', user.get('role', 'User'))

    db.users.update_one(
        {"email": email},
        {"$set": {"name": name, "role": role}}
    )
    return jsonify({"status": "success"})

@app.route('/update_password', methods=['POST'])
def update_password():
    data = request.json
    email = data['email'].lower()
    new_password = generate_password_hash(data['new_password'])

    db.users.update_one(
        {"email": email},
        {"$set": {"password": new_password}}
    )
    return jsonify({"status": "success"})

